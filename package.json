{
  "name": "dsh-tac",
  "version": "0.5.1",
  "description": "DeepSeek Harness plugin: project/session task board, floating session HUD, keyboard-first navigation, and task notifications.",
  "license": "CC-BY-NC-SA-4.0",
  "author": "CGArtLab",
  "keywords": [
    "dsh",
    "dsh-tac",
    "deepseek-harness",
    "plugin",
    "project-board",
    "session-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cgartlab/dsh-tac.git"
  },
  "homepage": "https://github.com/cgartlab/dsh-tac",
  "bugs": "https://github.com/cgartlab/dsh-tac/issues",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/check-bundle.cjs && node scripts/check-i18n.cjs && node scripts/check-screenshots.cjs",
    "check:bundle": "node scripts/check-bundle.cjs",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:screenshots": "node scripts/check-screenshots.cjs",
    "version:report": "node scripts/version-report.cjs",
    "test": "node --test test/load.test.cjs test/shortcuts.test.cjs test/github.test.cjs test/notifications.test.cjs test/lockfile-version.test.cjs test/version-consistency.test.cjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
